# O projeto usa SQLite por padrão no desenvolvimento local.
# Para utilizar PostgreSQL, configure as variáveis abaixo no ambiente do sistema.
DB_ENGINE=postgresql
DB_NAME=bnd_diesel
DB_USER=postgres
DB_PASSWORD=ALTERE_ESTA_SENHA
DB_HOST=127.0.0.1
DB_PORT=5432

# Em um ambiente de produção, configure também:
DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
