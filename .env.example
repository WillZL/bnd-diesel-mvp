# Desenvolvimento local:
# Não defina DB_ENGINE para utilizar SQLite automaticamente.

# Produção (Render + Neon):
# Cadastre estas variáveis diretamente no painel do Render.
# Não coloque credenciais reais neste arquivo.

# DB_ENGINE=postgresql
# DB_NAME=nome_do_banco
# DB_USER=usuario_do_banco
# DB_PASSWORD=sua_senha_aqui
# DB_HOST=seu_host_neon
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CHANNEL_BINDING=require

# DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=seu-servico.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-servico.onrender.com
